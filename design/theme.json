{
  "version": 1,
  "inputs": {
    "sourceColor": "#0246ff",
    "conformanceLevel": "AA",
    "typeScale": "standard",
    "cornerRadius": "floor"
  },
  "checks": {
    "tonal-palette": [
      {
        "kind": "generated"
      },
      {
        "kind": "blueprint",
        "file": "design/blueprint.json"
      }
    ],
    "color-contrast": [
      {
        "kind": "contrast",
        "scope": ":root",
        "foreground": "--primary",
        "background": "--background",
        "min": 4.5
      },
      {
        "kind": "contrast",
        "scope": ":root",
        "foreground": "--primary-foreground",
        "background": "--primary",
        "min": 4.5
      },
      {
        "kind": "contrast",
        "scope": ".dark",
        "foreground": "--primary",
        "background": "--background",
        "min": 4.5
      },
      {
        "kind": "contrast",
        "scope": ".dark",
        "foreground": "--primary-foreground",
        "background": "--primary",
        "min": 4.5
      }
    ],
    "type-scale-values": [
      {
        "kind": "absent",
        "variables": [
          "--text-xs",
          "--text-xs--line-height",
          "--text-sm",
          "--text-sm--line-height",
          "--text-base",
          "--text-base--line-height",
          "--text-lg",
          "--text-lg--line-height",
          "--text-xl",
          "--text-xl--line-height",
          "--text-2xl",
          "--text-2xl--line-height",
          "--text-3xl",
          "--text-3xl--line-height",
          "--text-4xl",
          "--text-4xl--line-height",
          "--text-5xl",
          "--text-5xl--line-height"
        ]
      }
    ],
    "spacing-values": [
      {
        "kind": "absent",
        "variables": ["--spacing"]
      }
    ],
    "radius-value": [
      {
        "kind": "value",
        "scope": ":root",
        "variable": "--radius",
        "expected": "0.625rem"
      }
    ],
    "checks-in-gate": [
      {
        "kind": "gate"
      }
    ],
    "design-tokens": [
      {
        "kind": "tokens",
        "file": "design/tokens.json"
      }
    ],
    "component-manifest": [
      {
        "kind": "components",
        "file": "design/component-registry.json",
        "folder": "src/components/ui"
      }
    ],
    "display-kind": [
      {
        "kind": "column-types",
        "file": "design/column-types.json"
      }
    ],
    "column-align": [
      {
        "kind": "columns",
        "file": "design/columns.json",
        "types": "design/column-types.json"
      },
      {
        "kind": "cells",
        "folder": "src",
        "skip": ["src/components/ui/", "src/generated/"],
        "rule": "align"
      }
    ],
    "column-width": [
      {
        "kind": "columns",
        "file": "design/columns.json",
        "types": "design/column-types.json"
      },
      {
        "kind": "cells",
        "folder": "src",
        "skip": ["src/components/ui/", "src/generated/"],
        "rule": "width"
      }
    ],
    "table-density": [
      {
        "kind": "cells",
        "folder": "src",
        "skip": ["src/components/ui/", "src/generated/"],
        "rule": "density"
      }
    ],
    "state-matrix": [
      {
        "kind": "states",
        "file": "design/states.json",
        "registry": "src/screens.ts"
      }
    ],
    "labels": [
      {
        "kind": "words",
        "folder": "src",
        "skip": ["src/components/ui/", "src/generated/"]
      }
    ],
    "error-copy": [
      {
        "kind": "error-copy",
        "folder": "src",
        "skip": ["src/components/ui/", "src/generated/"]
      }
    ],
    "notification-channel": [
      {
        "kind": "channels",
        "folder": "src",
        "sources": "src",
        "skip": ["src/components/ui/", "src/generated/"]
      }
    ],
    "page-layouts": [
      {
        "kind": "screen-kinds",
        "pages": "design/patterns",
        "registry": "src/screens.ts",
        "folder": "src"
      }
    ],
    "reference-implementation": [
      {
        "kind": "reference-screens",
        "pages": "design/patterns",
        "registry": "src/screens.ts",
        "file": "design/states.json",
        "folder": "src"
      }
    ],
    "test-screen-sizes": [
      {
        "kind": "screen-sizes",
        "file": "design/screen-sizes.json",
        "test": "tests/e2e/templates.spec.ts"
      }
    ],
    "tier-direction": [
      {
        "kind": "import-direction",
        "file": "design/parts.json",
        "sources": "src",
        "pages": "design/patterns"
      }
    ],
    "escapes": [
      {
        "kind": "slips",
        "file": "design/escapes.md"
      }
    ],
    "target-size": [
      {
        "kind": "target-size",
        "folder": "src/components/ui",
        "min": 24
      }
    ]
  }
}
