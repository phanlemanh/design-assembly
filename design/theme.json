        "kind": "lint",
        "rule": "no-restricted-syntax",
        "at": "src/App.tsx"
      }
    ],
    "color-palette": [
      {
        "kind": "lint",
        "rule": "shadcn/no-raw-colors",
        "at": "src/App.tsx"
      }
    ]
  },
  "affected": {
    "global": ["src/App.tsx", "src/main.tsx", "src/components/app-frame.tsx"],
    "none": ["wiki/**", "docs/**", "*.md"]
