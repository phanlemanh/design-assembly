        {
          "key": "gate",
          "name": "conformance",
          "options": {
            "make-check": "The checks run inside the repository's own gate, so they also run in CI."
          }
        }
      ]
    },
    {
      "id": "distribution",
      "title": "distribution",
      "depends_on": ["components"],
      "built": false
