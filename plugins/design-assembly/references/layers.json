      "built": true,
      "choices": [
        {
          "key": "conformance_level",
          "name": "conformance level",
          "options": {
            "AA": "The level most products commit to and most laws ask for.",
            "AAA": "Stricter contrast. Fewer colours qualify as a primary."
          }
        }
      ]
    },
    {
      "id": "foundations",
      "title": "foundations",
      "depends_on": ["context", "accessibility"],
      "built": true,
      "choices": [
        {
          "key": "source_color",
          "name": "source color"
        }
      ]
    },
    {
      "id": "components",
      "title": "core components",
      "depends_on": ["foundations"],
      "built": false
    },
    {
      "id": "interaction-patterns",
      "title": "interaction patterns",
      "depends_on": ["components"],
      "built": false
    },
    {
      "id": "content",
