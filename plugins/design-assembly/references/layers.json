      "choices": [
        {
          "key": "product_type",
          "name": "product type",
          "options": {
            "application": "People work in the screens: data-dense, task after task.",
            "content-site": "People mostly read: marketing, documentation, editorial."
          }
        }
      ]
    },
    {
      "id": "accessibility",
      "title": "accessibility",
